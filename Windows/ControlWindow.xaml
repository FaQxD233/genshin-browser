<Window x:Class="GenshinBrowser.Windows.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GenshinBrowser.Models"
        xmlns:services="clr-namespace:GenshinBrowser.Services"
        Title="{DynamicResource Control.Title}"
        Width="560"
        Height="640"
        MinWidth="400"
        MinHeight="440"
        Background="{DynamicResource BackgroundPrimary}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="Manual"
        AllowsTransparency="False"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True"
        Focusable="True">
  <Window.Resources>
    <services:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

    <DataTemplate x:Key="DownloadItemTemplate" DataType="{x:Type models:DownloadItem}">
      <Grid Margin="0,4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Medium"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                     ToolTip="{Binding FileName}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="11"
                     Margin="12,0,0,0" Foreground="{DynamicResource TextTertiary}"
                     VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ProgressBar Grid.Column="0" Style="{StaticResource ModernProgressBar}"
                       Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center" Height="5"/>
          <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11"
                     Margin="10,0,0,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
          <!-- 操作按钮右对齐；不可用的重试/取消 Collapsed，完成后前两个键贴到最右 -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Width="28" Height="24" Padding="0"
                    Command="{Binding DataContext.OpenDownloadFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{DynamicResource Downloads.OpenFile}"
                    IsEnabled="{Binding CanOpen}"
                    AutomationProperties.Name="{DynamicResource Downloads.OpenFile}">
              <!-- E8E5=打开文件、ED25=打开的文件夹（原 E7B3 是眼睛）。这几个 28×24 按钮须 Padding=0：
                   IconButton 默认 Padding=8 只给图标留约 10×6，12px 字形会被布局裁成碎片 -->
              <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE8E5;" FontSize="12"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Width="28" Height="24" Padding="0" Margin="4,0,0,0"
                    Command="{Binding DataContext.OpenDownloadFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{DynamicResource Downloads.OpenFolder}"
                    IsEnabled="{Binding CanOpenInFolder}"
                    AutomationProperties.Name="{DynamicResource Downloads.OpenFolder}">
              <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xED25;" FontSize="12"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Width="28" Height="24" Padding="0" Margin="4,0,0,0"
                    Command="{Binding DataContext.RetryDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{DynamicResource Downloads.Retry}"
                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{DynamicResource Downloads.Retry}">
              <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE72C;" FontSize="12"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Width="28" Height="24" Padding="0" Margin="4,0,0,0"
                    Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    ToolTip="{DynamicResource Downloads.Cancel}"
                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{DynamicResource Downloads.Cancel}">
              <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE711;" FontSize="12"/>
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="16,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid.Triggers>
      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>

    <!-- Row 0: 顶栏 — 左侧 浏览|浮窗 分段，右侧工具 -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource SegmentedTrack}">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource SegmentedItem}"
                  Command="{Binding SetBrowsingModeCommand}" Tag="{Binding IsBrowsingMode}"
                  Content="{DynamicResource Mode.Free}"
                  ToolTip="{Binding SwitchToBrowsingTooltip}"
                  AutomationProperties.Name="{DynamicResource Mode.Free}"
                  MinWidth="56" Height="26" FontSize="12" FontWeight="SemiBold"/>
          <Button Style="{StaticResource SegmentedItem}"
                  Command="{Binding SetFloatingModeCommand}" Tag="{Binding IsFloatingMode}"
                  Content="{DynamicResource Mode.Fixed}"
                  ToolTip="{Binding SwitchToFloatingTooltip}"
                  AutomationProperties.Name="{DynamicResource Mode.Fixed}"
                  MinWidth="56" Height="26" FontSize="12" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource IconButton}" Width="34" Height="30" Margin="0,0,6,0" Padding="0"
                Command="{Binding TogglePlaybackCommand}" ToolTip="{Binding PlaybackTooltip}"
                AutomationProperties.Name="{DynamicResource Toolbar.PlaybackName}">
          <!-- E768=播放（E769 是暂停图标，暂停状态下显示它会让人误以为正在播放） -->
          <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE768;" FontSize="13"/>
        </Button>
        <Button x:Name="SettingsButton" Style="{StaticResource ToolbarToggleButton}" Tag="{Binding IsSettingsExpanded}"
                Width="34" Height="30" Margin="0,0,6,0"
                Command="{Binding ToggleSettingsCommand}"
                ToolTip="{DynamicResource Toolbar.SettingsTooltip}" AutomationProperties.Name="{DynamicResource Toolbar.SettingsName}">
          <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE713;" FontSize="13"/>
        </Button>
        <Button x:Name="KeyBindingsButton" Style="{StaticResource ToolbarToggleButton}" Tag="{Binding IsKeyBindingsExpanded}"
                Width="34" Height="30" Margin="0,0,6,0"
                Command="{Binding ToggleKeyBindingsCommand}"
                ToolTip="{DynamicResource Toolbar.KeysTooltip}" AutomationProperties.Name="{DynamicResource Toolbar.KeysName}">
          <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE765;" FontSize="13"/>
        </Button>
        <Button x:Name="DownloadsButton" Style="{StaticResource ToolbarToggleButton}" Tag="{Binding IsDownloadsExpanded}"
                Width="34" Height="30"
                Command="{Binding ToggleDownloadsCommand}"
                ToolTip="{DynamicResource Toolbar.DownloadsTooltip}" AutomationProperties.Name="{DynamicResource Toolbar.DownloadsName}">
          <Grid Width="18" Height="18">
            <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE896;" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border Visibility="{Binding HasDownloadsBadge, Converter={StaticResource BoolToVisibility}}">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DownloadsBadgeBorder}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasInterruptedDownloads}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource AccentDanger}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding DownloadsBadgeText}"
                         FontSize="9" FontWeight="SemiBold"
                         Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Row 1: 设置面板
         外层透明壳只负责 MaxHeight 动画（折叠=0，不占位）；
         内层才是可见底色，Margin 底 12 在壳内，折叠时一并被裁掉 -->
    <Border Grid.Row="1" x:Name="SettingsPanelBorder"
            Background="Transparent"
            Margin="0" Padding="0"
            ClipToBounds="True" MaxHeight="0" Opacity="0">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="372" Duration="0:0:0.2"
                                     EasingFunction="{StaticResource EaseOutCubic}"/>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.16"
                                     EasingFunction="{StaticResource EaseOutCubic}"/>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border Background="{DynamicResource BackgroundSecondary}"
              CornerRadius="6"
              Padding="10,8"
              Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Settings.Title}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Style="{StaticResource ModernButton}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Padding="8,3" Height="24" FontSize="11" Margin="0,0,6,0"
                      Command="{Binding ClearBrowsingDataCommand}"
                      ToolTip="{DynamicResource Settings.ClearBrowsingDataTooltip}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE74D;" Margin="0,0,5,0" FontSize="11"/>
                  <TextBlock Text="{DynamicResource Settings.ClearBrowsingData}" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>
              </Button>
              <!-- 管理配置：点开下拉菜单（导入、导出配置、数据目录、恢复默认），菜单样式与收藏 / 历史右键菜单相同 -->
              <Button x:Name="ManageConfigButton" Style="{StaticResource ModernButton}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Padding="8,3" Height="24" FontSize="11"
                      ToolTip="{DynamicResource Settings.ManageConfigTooltip}"
                      AutomationProperties.Name="{DynamicResource Settings.ManageConfig}"
                      Click="ManageConfigButton_OnClick">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE9E9;" Margin="0,0,5,0" FontSize="11"/>
                  <TextBlock Text="{DynamicResource Settings.ManageConfig}" VerticalAlignment="Center" FontSize="11"/>
                  <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE70D;" Margin="5,1,0,0" FontSize="8"/>
                </StackPanel>
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{DynamicResource Settings.ConfigImport}" ToolTip="{DynamicResource Settings.ConfigImportTooltip}"
                              Click="ImportConfigMenuItem_OnClick">
                      <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE8B5;" FontSize="13"/>
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Settings.ConfigExport}" ToolTip="{DynamicResource Settings.ConfigExportTooltip}"
                              Click="ExportConfigMenuItem_OnClick">
                      <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xEDE1;" FontSize="13"/>
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource Settings.DataDirectory}" ToolTip="{DynamicResource Settings.DataDirectoryTooltip}"
                              Click="DataDirectoryMenuItem_OnClick">
                      <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE8B7;" FontSize="13"/>
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{DynamicResource Settings.RestoreDefaults}" ToolTip="{DynamicResource Settings.RestoreDefaultsTooltip}"
                              Click="RestoreDefaultsMenuItem_OnClick">
                      <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE72C;" FontSize="13"/>
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        MaxHeight="312">
            <!-- 标签列按最长标签自适应并跨行对齐（SettingsLabel），最小 68：英文长标签不被截断。
                 上、右各留 2px 给外扩的键盘焦点框（首行「应用」、右缘贴边按钮贴着滚动区边缘，否则被裁）；
                 这 2px 从标题下边距和原滚动区右内边距挪来，内容位置不变 -->
            <StackPanel Grid.IsSharedSizeScope="True" Margin="0,2,2,0">
              <!-- 窗口：大小 / 贴边 / 鼠标穿透 -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="68" SharedSizeGroup="SettingsLabel"/>
                  <ColumnDefinition Width="58"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="58"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Settings.WindowSize}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="BrowserWindowWidthBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                         Height="26" Padding="6,2" FontSize="11"
                         VerticalContentAlignment="Center"
                         ToolTip="{DynamicResource Settings.Width}"
                         Text="{Binding BrowserWindowWidthText, UpdateSourceTrigger=PropertyChanged}">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ApplyWindowSizeCommand}"/>
                  </TextBox.InputBindings>
                </TextBox>
                <TextBlock Grid.Column="2" Text="×" Foreground="{DynamicResource TextTertiary}"
                           FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox x:Name="BrowserWindowHeightBox" Grid.Column="3" Style="{StaticResource ModernTextBox}"
                         Height="26" Padding="6,2" FontSize="11"
                         VerticalContentAlignment="Center"
                         ToolTip="{DynamicResource Settings.Height}"
                         Text="{Binding BrowserWindowHeightText, UpdateSourceTrigger=PropertyChanged}">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ApplyWindowSizeCommand}"/>
                  </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="4" Style="{StaticResource ModernButton}" Padding="10,3" Margin="6,0,0,0"
                        FontSize="11" Height="26"
                        Command="{Binding ApplyWindowSizeCommand}"
                        Content="{DynamicResource Settings.ApplySize}"
                        ToolTip="{DynamicResource Settings.ApplySizeTooltip}"/>
              </Grid>

              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="68" SharedSizeGroup="SettingsLabel"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Settings.MoveCorner}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <!-- ↖↗↙↘ 方向一目了然，避免 MDL2 图标语义错位 -->
                <Button Grid.Column="1" Style="{StaticResource ModernButton}" Height="26" Margin="0,0,4,0"
                        Padding="0" FontSize="14" FontWeight="SemiBold"
                        Command="{Binding MoveBrowserToCornerCommand}" CommandParameter="TopLeft"
                        Content="↖"
                        ToolTip="{DynamicResource Settings.MoveTopLeftTooltip}"
                        AutomationProperties.Name="{DynamicResource Settings.MoveTopLeft}"/>
                <Button Grid.Column="2" Style="{StaticResource ModernButton}" Height="26" Margin="0,0,4,0"
                        Padding="0" FontSize="14" FontWeight="SemiBold"
                        Command="{Binding MoveBrowserToCornerCommand}" CommandParameter="TopRight"
                        Content="↗"
                        ToolTip="{DynamicResource Settings.MoveTopRightTooltip}"
                        AutomationProperties.Name="{DynamicResource Settings.MoveTopRight}"/>
                <Button Grid.Column="3" Style="{StaticResource ModernButton}" Height="26" Margin="0,0,4,0"
                        Padding="0" FontSize="14" FontWeight="SemiBold"
                        Command="{Binding MoveBrowserToCornerCommand}" CommandParameter="BottomLeft"
                        Content="↙"
                        ToolTip="{DynamicResource Settings.MoveBottomLeftTooltip}"
                        AutomationProperties.Name="{DynamicResource Settings.MoveBottomLeft}"/>
                <Button Grid.Column="4" Style="{StaticResource ModernButton}" Height="26"
                        Padding="0" FontSize="14" FontWeight="SemiBold"
                        Command="{Binding MoveBrowserToCornerCommand}" CommandParameter="BottomRight"
                        Content="↘"
                        ToolTip="{DynamicResource Settings.MoveBottomRightTooltip}"
                        AutomationProperties.Name="{DynamicResource Settings.MoveBottomRight}"/>
              </Grid>

              <!-- 浮窗鼠标穿透：布尔项用开关 -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="68" SharedSizeGroup="SettingsLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Settings.ClickThrough}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="{Binding ClickThroughTooltip}"/>
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                          HorizontalAlignment="Left"
                          IsChecked="{Binding IsClickThroughOn}"
                          ToolTip="{Binding ClickThroughTooltip}"
                          AutomationProperties.Name="{DynamicResource Settings.ClickThrough}"/>
              </Grid>

              <!-- 显示：不透明度 / 页面缩放同一行：− 数值 % + 重置 -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 不透明度组：label − [输入] % + 重置 -->
                <Grid Grid.Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Opacity}" Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <Button Grid.Column="1" Style="{StaticResource ModernButton}" Width="28" Height="26" MinWidth="0" Padding="0"
                          Command="{Binding OpacityOutCommand}" ToolTip="{DynamicResource Settings.OpacityOutTooltip}">
                    <TextBlock Text="−" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                  </Button>
                  <TextBox x:Name="OpacityPercentBox" Grid.Column="2" Style="{StaticResource ModernTextBox}"
                           Height="26" Padding="2,2" FontSize="11" Margin="4,0"
                           VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                           Text="{Binding OpacityPercentText, UpdateSourceTrigger=PropertyChanged}"
                           GotKeyboardFocus="PercentBox_OnGotKeyboardFocus"
                           LostKeyboardFocus="OpacityPercentBox_OnLostKeyboardFocus">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding ApplyOpacityCommand}"/>
                    </TextBox.InputBindings>
                  </TextBox>
                  <TextBlock Grid.Column="3" Text="{DynamicResource Settings.PercentUnit}"
                             FontSize="11" Foreground="{DynamicResource TextTertiary}"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="4" Style="{StaticResource ModernButton}" Width="28" Height="26" MinWidth="0" Padding="0" Margin="4,0,0,0"
                          Command="{Binding OpacityInCommand}" ToolTip="{DynamicResource Settings.OpacityInTooltip}">
                    <TextBlock Text="+" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                  </Button>
                  <Button Grid.Column="5" Style="{StaticResource ModernButton}" Padding="8,3" Margin="4,0,0,0"
                          Height="26" FontSize="11"
                          Command="{Binding ResetOpacityCommand}" ToolTip="{DynamicResource Settings.OpacityResetTooltip}"
                          Content="{DynamicResource Settings.ZoomReset}"/>
                </Grid>
                <!-- 缩放组：label − [输入] % + 重置 -->
                <Grid Grid.Column="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Zoom}" Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <Button Grid.Column="1" Style="{StaticResource ModernButton}" Width="28" Height="26" MinWidth="0" Padding="0"
                          Command="{Binding ZoomOutCommand}" ToolTip="{DynamicResource Settings.ZoomOutTooltip}"
                          AutomationProperties.Name="{DynamicResource Settings.ZoomOutName}">
                    <TextBlock Text="−" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                  </Button>
                  <TextBox x:Name="ZoomPercentBox" Grid.Column="2" Style="{StaticResource ModernTextBox}"
                           Height="26" Padding="2,2" FontSize="11" Margin="4,0"
                           VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                           Text="{Binding ZoomPercentText, UpdateSourceTrigger=PropertyChanged}"
                           GotKeyboardFocus="PercentBox_OnGotKeyboardFocus"
                           LostKeyboardFocus="ZoomPercentBox_OnLostKeyboardFocus">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding ApplyZoomCommand}"/>
                    </TextBox.InputBindings>
                  </TextBox>
                  <TextBlock Grid.Column="3" Text="{DynamicResource Settings.PercentUnit}"
                             FontSize="11" Foreground="{DynamicResource TextTertiary}"
                             VerticalAlignment="Center"/>
                  <Button Grid.Column="4" Style="{StaticResource ModernButton}" Width="28" Height="26" MinWidth="0" Padding="0" Margin="4,0,0,0"
                          Command="{Binding ZoomInCommand}" ToolTip="{DynamicResource Settings.ZoomInTooltip}"
                          AutomationProperties.Name="{DynamicResource Settings.ZoomInName}">
                    <TextBlock Text="+" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                  </Button>
                  <Button Grid.Column="5" Style="{StaticResource ModernButton}" Padding="8,3" Margin="4,0,0,0"
                          Height="26" FontSize="11"
                          Command="{Binding ResetZoomCommand}" ToolTip="{DynamicResource Settings.ZoomResetTooltip}"
                          Content="{DynamicResource Settings.ZoomReset}"/>
                </Grid>
              </Grid>

              <!-- 外观：主题、语言各占一行（分段控件按内容宽度，同一行放两组在窄窗口会溢出） -->
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="68" SharedSizeGroup="SettingsLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Theme}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Grid.Column="1" Style="{StaticResource SegmentedTrack}">
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SegmentedItem}"
                            Command="{Binding SetThemeDarkCommand}" Tag="{Binding IsThemeDark}"
                            Content="{DynamicResource Settings.ThemeDark}"/>
                    <Button Style="{StaticResource SegmentedItem}"
                            Command="{Binding SetThemeLightCommand}" Tag="{Binding IsThemeLight}"
                            Content="{DynamicResource Settings.ThemeLight}"/>
                    <Button Style="{StaticResource SegmentedItem}"
                            Command="{Binding SetThemeSystemCommand}" Tag="{Binding IsThemeSystem}"
                            Content="{DynamicResource Settings.ThemeSystem}"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="68" SharedSizeGroup="SettingsLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Language}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Grid.Column="1" Style="{StaticResource SegmentedTrack}">
                  <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SegmentedItem}"
                            Command="{Binding SetLanguageZhCommand}" Tag="{Binding IsLanguageZh}"
                            Content="{DynamicResource Settings.LanguageZh}"/>
                    <Button Style="{StaticResource SegmentedItem}"
                            Command="{Binding SetLanguageEnCommand}" Tag="{Binding IsLanguageEn}"
                            Content="{DynamicResource Settings.LanguageEn}"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Border>

    <!-- Row 2: 按键绑定面板 — 与设置面板同一双层结构 -->
    <Border Grid.Row="2" x:Name="KeyBindingsPanelBorder"
            Background="Transparent"
            Margin="0" Padding="0"
            ClipToBounds="True" MaxHeight="0" Opacity="0">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyBindingsExpanded}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="270" Duration="0:0:0.2"
                                     EasingFunction="{StaticResource EaseOutCubic}"/>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.16"
                                     EasingFunction="{StaticResource EaseOutCubic}"/>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border Background="{DynamicResource BackgroundSecondary}"
              CornerRadius="6"
              Padding="10,8"
              Margin="0,0,0,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="236">
        <!-- 标签列按最长标签自适应（KeyLabel 跨热键表与生效范围行对齐），最小 68 -->
        <StackPanel Grid.IsSharedSizeScope="True">
          <TextBlock Text="{DynamicResource Keys.Title}" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                <!-- 快捷键用键帽样式；录制中的键帽经 Tag 高亮，一眼看出正在录哪一组 -->
                <Grid Margin="0,0,0,8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="68" SharedSizeGroup="KeyLabel"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto" MinWidth="68"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings.ToggleMode}" Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button Grid.Row="0" Grid.Column="1" Content="{Binding ToggleModeKeyText}"
                          Command="{Binding RecordToggleModeKeyCommand}" Tag="{Binding IsRecordingToggleModeKey}"
                          Style="{StaticResource KeyCapButton}"/>
                  <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource Settings.Playback}" Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button Grid.Row="0" Grid.Column="4" Content="{Binding TogglePlaybackKeyText}"
                          Command="{Binding RecordTogglePlaybackKeyCommand}" Tag="{Binding IsRecordingTogglePlaybackKey}"
                          Style="{StaticResource KeyCapButton}"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings.HideOverlay}" Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" VerticalAlignment="Center" Margin="0,6,8,0"/>
                  <Button Grid.Row="1" Grid.Column="1" Content="{Binding ToggleHideKeyText}"
                          Command="{Binding RecordToggleHideKeyCommand}" Tag="{Binding IsRecordingToggleHideKey}"
                          Style="{StaticResource KeyCapButton}" Margin="0,6,0,0"/>
                  <TextBlock Grid.Row="1" Grid.Column="3" Text="{DynamicResource Settings.SeekBackward}" Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" VerticalAlignment="Center" Margin="0,6,8,0"/>
                  <Button Grid.Row="1" Grid.Column="4" Content="{Binding SeekBackwardKeyText}"
                          Command="{Binding RecordSeekBackwardKeyCommand}" Tag="{Binding IsRecordingSeekBackwardKey}"
                          Style="{StaticResource KeyCapButton}" Margin="0,6,0,0"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Settings.SeekForward}" Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" VerticalAlignment="Center" Margin="0,6,8,0"/>
                  <Button Grid.Row="2" Grid.Column="1" Content="{Binding SeekForwardKeyText}"
                          Command="{Binding RecordSeekForwardKeyCommand}" Tag="{Binding IsRecordingSeekForwardKey}"
                          Style="{StaticResource KeyCapButton}" Margin="0,6,0,0"/>
                </Grid>

                <!-- 热键生效范围：黑名单外 / 全部应用 / 关闭 -->
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="68" SharedSizeGroup="KeyLabel"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{DynamicResource Settings.HotkeyScope}" Foreground="{DynamicResource TextSecondary}"
                             FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                             ToolTip="{DynamicResource Settings.HotkeyScopeTooltip}"/>
                  <Border Grid.Column="1" Style="{StaticResource SegmentedTrack}">
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource SegmentedItem}"
                              Command="{Binding SetHotkeyScopeBlacklistCommand}" Tag="{Binding IsHotkeyScopeBlacklist}"
                              Content="{DynamicResource Settings.HotkeyScopeBlacklist}"
                              ToolTip="{DynamicResource Settings.HotkeyScopeBlacklistTooltip}"/>
                      <Button Style="{StaticResource SegmentedItem}"
                              Command="{Binding SetHotkeyScopeAllAppsCommand}" Tag="{Binding IsHotkeyScopeAllApps}"
                              Content="{DynamicResource Settings.HotkeyScopeAllApps}"
                              ToolTip="{DynamicResource Settings.HotkeyScopeAllAppsTooltip}"/>
                      <Button Style="{StaticResource SegmentedItem}"
                              Command="{Binding SetHotkeyScopeOffCommand}" Tag="{Binding IsHotkeyScopeOff}"
                              Content="{DynamicResource Settings.HotkeyScopeOff}"
                              ToolTip="{DynamicResource Settings.HotkeyScopeOffTooltip}"/>
                    </StackPanel>
                  </Border>
                </Grid>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

    <!-- Row 3: 下载面板 — 与设置同一双层结构 -->
    <Border Grid.Row="3" x:Name="DownloadsPanelBorder"
            Background="Transparent"
            Margin="0" Padding="0"
            ClipToBounds="True" MaxHeight="0" Opacity="0">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsDownloadsExpanded}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="260" Duration="0:0:0.2"
                                     EasingFunction="{StaticResource EaseOutCubic}"/>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.16"
                                     EasingFunction="{StaticResource EaseOutCubic}"/>
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.ExitActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Border Background="{DynamicResource BackgroundSecondary}"
              CornerRadius="6"
              Padding="12"
              Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Downloads.Title}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Style="{StaticResource ModernButton}" Padding="10,5" FontSize="11"
                    Command="{Binding ClearFinishedDownloadsCommand}"
                    ToolTip="{DynamicResource Downloads.ClearFinishedTooltip}"
                    Content="{DynamicResource Downloads.ClearFinished}"/>
          </Grid>
          <Grid Grid.Row="1" MinHeight="72" MaxHeight="168">
            <ListBox x:Name="DownloadsListBox"
                     Style="{StaticResource ModernListBox}"
                     ItemsSource="{Binding Downloads}"
                     ItemTemplate="{StaticResource DownloadItemTemplate}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}">
                  <Setter Property="Padding" Value="8,6"/>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Text="{Binding DownloadsEmptyText}"
                       FontSize="13" Foreground="{DynamicResource TextTertiary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"
                       MaxWidth="280" IsHitTestVisible="False"
                       Visibility="{Binding HasNoDownloads, Converter={StaticResource BoolToVisibility}}"/>
          </Grid>
        </Grid>
      </Border>
    </Border>

    <!-- Row 4: 地址栏 — 主次动作分层；进度条与地址框对齐 -->
    <Grid Grid.Row="4" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Top">
        <Button Style="{StaticResource IconButton}" Width="34" Height="32" Margin="0,0,6,0"
                Command="{Binding GoBackCommand}"
                IsEnabled="{Binding CanGoBack}"
                ToolTip="{DynamicResource Nav.Back}" AutomationProperties.Name="{DynamicResource Nav.Back}">
          <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE72B;" FontSize="13"/>
        </Button>
        <Button Style="{StaticResource IconButton}" Width="34" Height="32"
                Command="{Binding GoForwardCommand}"
                IsEnabled="{Binding CanGoForward}"
                ToolTip="{DynamicResource Nav.Forward}" AutomationProperties.Name="{DynamicResource Nav.Forward}">
          <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE72A;" FontSize="13"/>
        </Button>
      </StackPanel>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 占位文字是装饰层（Adorner）画的：放进自己的 AdornerDecorator，才会被窗内询问卡片盖住，
             否则画在窗口最顶层、浮在卡片上面 -->
        <AdornerDecorator Grid.Row="0">
          <TextBox x:Name="AddressBarTextBox"
                   Height="32"
                   VerticalContentAlignment="Center"
                   Style="{StaticResource ModernTextBox}"
                   services:Placeholder.Text="{DynamicResource Nav.AddressPlaceholder}"
                   services:Placeholder.Foreground="{DynamicResource TextTertiary}"
                   ToolTip="{DynamicResource Nav.AddressTooltip}"
                   TextChanged="AddressBarTextBox_OnTextChanged"
                   LostKeyboardFocus="AddressBarTextBox_OnLostKeyboardFocus">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter"
                          Command="{Binding NavigateFromAddressBarCommand}"
                          CommandParameter="{Binding Text, ElementName=AddressBarTextBox}" />
            </TextBox.InputBindings>
          </TextBox>
        </AdornerDecorator>
        <ProgressBar Grid.Row="1" Margin="0,4,0,0" Height="2"
                     Style="{StaticResource AddressBarProgressBar}"
                     Visibility="{Binding IsNavigating, Converter={StaticResource BoolToVisibility}}"/>

        <!-- 地址栏联想：收藏 / 历史候选。列表与项都不可聚焦，键盘焦点始终留在地址栏；
             开关由 VM 控制，失焦 / 窗口移动 / 打开候选时关闭 -->
        <Popup x:Name="AddressSuggestionsPopup"
               PlacementTarget="{Binding ElementName=AddressBarTextBox}"
               Placement="Bottom"
               VerticalOffset="4"
               AllowsTransparency="True"
               Focusable="False"
               IsOpen="{Binding IsAddressSuggestionsOpen, Mode=OneWay}">
          <Border Width="{Binding ActualWidth, ElementName=AddressBarTextBox}"
                  Background="{DynamicResource BackgroundTertiary}"
                  BorderBrush="{DynamicResource BorderColor}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource CornerRadiusSm}"
                  Padding="2">
            <ListBox x:Name="AddressSuggestionsList"
                     Style="{StaticResource ModernListBox}"
                     ItemsSource="{Binding AddressSuggestions}"
                     Background="Transparent"
                     Focusable="False"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="AddressSuggestionsList_OnPreviewMouseLeftButtonUp">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}">
                  <Setter Property="Focusable" Value="False"/>
                  <Setter Property="Padding" Value="8,6"/>
                  <Setter Property="Cursor" Value="Hand"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 历史 = 时钟 E121，收藏 = 星标 E735 -->
                    <TextBlock x:Name="KindIcon" Style="{StaticResource Mdl2IconText}"
                               Text="&#xE121;" FontSize="12" Margin="0,2,8,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextTertiary}"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                      <TextBlock Text="{Binding DisplayUrl}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                 Foreground="{DynamicResource TextTertiary}"/>
                    </StackPanel>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                      <Setter TargetName="KindIcon" Property="Text" Value="&#xE735;"/>
                      <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource AccentWarning}"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Popup>
      </Grid>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Top">
        <!-- 普通样式：回车即可跳转，这个按钮使用频率低，不再用绿色主按钮抢走地址栏与列表的视觉重心 -->
        <Button Style="{StaticResource ModernButton}" Height="32" MinWidth="56" Padding="12,5" Margin="0,0,6,0"
                Command="{Binding NavigateFromAddressBarCommand}"
                CommandParameter="{Binding Text, ElementName=AddressBarTextBox}"
                Content="{DynamicResource Nav.Open}"
                ToolTip="{DynamicResource Nav.Open}"/>
        <Button Style="{StaticResource IconButton}" Width="34" Height="32" Margin="0,0,6,0" Padding="0"
                Command="{Binding ReloadCommand}"
                ToolTip="{DynamicResource Nav.Reload}" AutomationProperties.Name="{DynamicResource Nav.Reload}">
          <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE72C;" FontSize="13"/>
        </Button>
        <Button Style="{StaticResource IconButton}" Width="34" Height="32" Padding="0"
                Command="{Binding ToggleFavoriteCommand}"
                ToolTip="{Binding FavoriteToggleText}"
                AutomationProperties.Name="{Binding FavoriteToggleText}">
          <TextBlock>
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Mdl2IconText}">
                <Setter Property="Text" Value="&#xE734;"/>
                <Setter Property="FontSize" Value="13"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCurrentFavorite}" Value="True">
                    <Setter Property="Text" Value="&#xE735;"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Button>
      </StackPanel>
    </Grid>

    <!-- 顶栏/地址栏 与 列表区 的分隔：一条细线，不用卡片 -->
    <Grid Grid.Row="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,10" Opacity="0.7"/>

      <!-- Tab -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
        <RadioButton GroupName="ListTabs" Style="{StaticResource TabRadioButton}"
                     IsChecked="{Binding IsFavoritesTab, Mode=TwoWay}"
                     Margin="0,0,4,0"
                     ToolTip="{DynamicResource Fav.Tab}" AutomationProperties.Name="{DynamicResource Fav.Tab}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE734;" Margin="0,0,6,0" FontSize="13"/>
            <TextBlock Text="{DynamicResource Fav.Tab}" VerticalAlignment="Center"/>
          </StackPanel>
        </RadioButton>
        <RadioButton GroupName="ListTabs" Style="{StaticResource TabRadioButton}"
                     IsChecked="{Binding IsHistoryTab, Mode=TwoWay}"
                     ToolTip="{DynamicResource History.Tab}" AutomationProperties.Name="{DynamicResource History.Tab}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE121;" Margin="0,0,6,0" FontSize="13"/>
            <TextBlock Text="{DynamicResource History.Tab}" VerticalAlignment="Center"/>
          </StackPanel>
        </RadioButton>
      </StackPanel>

      <!-- 搜索 -->
      <Grid Grid.Row="2" Margin="0,0,0,10">
        <!-- 占位文字放进自己的装饰层，原因同地址栏 -->
        <AdornerDecorator>
          <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}"
                   Padding="28,8,12,8"
                   services:Placeholder.Text="{DynamicResource Search.Placeholder}"
                   services:Placeholder.Foreground="{DynamicResource TextTertiary}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="{DynamicResource Search.Tooltip}"/>
        </AdornerDecorator>
        <TextBlock Style="{StaticResource Mdl2IconText}" Text="&#xE721;"
                   FontSize="13" Foreground="{DynamicResource TextTertiary}"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="12,0,0,0" IsHitTestVisible="False"/>
      </Grid>

      <!-- 列表：直接铺在窗口背景上，不外包一层卡片 -->
      <Grid Grid.Row="3">
        <ListBox x:Name="FavoritesListBox"
                 ItemsSource="{Binding FavoriteItems}"
                 ItemTemplate="{StaticResource BrowserListItemTemplate}"
                 MouseDoubleClick="FavoritesListBox_OnMouseDoubleClick"
                 MouseRightButtonUp="FavoritesListBox_OnRightClick"
                 KeyDown="ListBox_OnKeyDown"
                 BorderThickness="0">
          <ListBox.Style>
            <Style TargetType="ListBox" BasedOn="{StaticResource ModernListBox}">
              <Setter Property="Background" Value="Transparent"/>
              <!-- 保留 Visibility=Visible 让 Opacity 动画起效（Collapsed 会跳过渲染管线）；
                   用 IsHitTestVisible=False 屏蔽非激活 Tab 的鼠标事件，
                   TabNavigation=None 让非激活 Tab 整棵子树不进入 Tab 键导航 -->
              <Setter Property="Visibility" Value="Visible"/>
              <Setter Property="Opacity" Value="0"/>
              <Setter Property="IsHitTestVisible" Value="False"/>
              <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavoritesTab}" Value="True">
                  <Setter Property="IsHitTestVisible" Value="True"/>
                  <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue"/>
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutCubic}"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.Style>
          <ListBox.ItemContainerStyle>
            <StaticResource ResourceKey="ModernListBoxItem"/>
          </ListBox.ItemContainerStyle>
        </ListBox>

        <ListBox x:Name="HistoryListBox"
                 ItemsSource="{Binding HistoryItems}"
                 ItemTemplate="{StaticResource BrowserListItemTemplate}"
                 MouseDoubleClick="HistoryListBox_OnMouseDoubleClick"
                 MouseRightButtonUp="HistoryListBox_OnRightClick"
                 KeyDown="ListBox_OnKeyDown"
                 BorderThickness="0">
          <ListBox.Style>
            <Style TargetType="ListBox" BasedOn="{StaticResource ModernListBox}">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Visibility" Value="Visible"/>
              <Setter Property="Opacity" Value="1"/>
              <Setter Property="IsHitTestVisible" Value="True"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavoritesTab}" Value="True">
                  <Setter Property="IsHitTestVisible" Value="False"/>
                  <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOutCubic}"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.ExitActions>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.Style>
          <ListBox.ItemContainerStyle>
            <StaticResource ResourceKey="ModernListBoxItem"/>
          </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock Text="{Binding FavoritesEmptyText}"
                   FontSize="13" Foreground="{DynamicResource TextTertiary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"
                   MaxWidth="280" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFavoritesTab}" Value="True"/>
                    <Condition Binding="{Binding FavoriteItems.Count}" Value="0"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="{Binding HistoryEmptyText}"
                   FontSize="13" Foreground="{DynamicResource TextTertiary}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"
                   MaxWidth="280" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsFavoritesTab}" Value="False"/>
                    <Condition Binding="{Binding HistoryItems.Count}" Value="0"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Grid>

    <!-- 外层只负责淡入淡出，必须直接使用 ToastBorderStyle：BasedOn 派生样式中，基样式里
         Tag DataTrigger 的 Enter/ExitActions 不执行（实测 Opacity 恒为 0，所有 Toast 不可见）。
         严重度描边放在内层 Border 自己的样式里 -->
    <Border Grid.RowSpan="6"
            Style="{StaticResource ToastBorderStyle}"
            Tag="{Binding IsToastVisible}"
            Visibility="{Binding ToastVisibility}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            MaxWidth="360"
            Margin="0,0,8,8">
      <Border Background="{DynamicResource BackgroundTertiary}"
              CornerRadius="8"
              BorderThickness="1">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding ToastSeverity}" Value="Success">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentSuccess}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding ToastSeverity}" Value="Warning">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentWarning}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding ToastSeverity}" Value="Error">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentDanger}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <!-- 左侧 4px 严重度色条：与 BorderBrush 联动，让 Toast 类型一眼可辨 -->
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" CornerRadius="2,0,0,2" Margin="0,6">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ToastSeverity}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource AccentSuccess}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ToastSeverity}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource AccentWarning}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ToastSeverity}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource AccentDanger}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
          <TextBlock Grid.Column="1" FontSize="14"
                     VerticalAlignment="Center" Margin="12,12,8,12">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Mdl2IconText}">
                <Setter Property="Text" Value="&#xE946;"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ToastSeverity}" Value="Success">
                    <Setter Property="Text" Value="&#xE73E;"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentSuccess}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ToastSeverity}" Value="Warning">
                    <Setter Property="Text" Value="&#xE7BA;"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ToastSeverity}" Value="Error">
                    <Setter Property="Text" Value="&#xE783;"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentDanger}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="2" Text="{Binding ToastMessage}" Foreground="{DynamicResource TextPrimary}"
                     TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,12,14,12"/>
        </Grid>
      </Border>
    </Border>

    <!-- 窗内模态询问（导入配置时的冲突选择）：遮罩盖住整个窗口（负外边距抵掉根 Grid 的边距），点遮罩不关闭；
         居中卡片 = 标题 + 一句说明 + 底栏等宽按钮，第一项为主按钮并获得焦点，Esc 取消。按钮在代码里按选项生成 -->
    <Grid x:Name="ModalLayer" Grid.RowSpan="6" Margin="-16,-14" Panel.ZIndex="100"
          Visibility="Collapsed" Background="{DynamicResource ModalBackdropBrush}"
          KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
          PreviewKeyDown="ModalLayer_OnPreviewKeyDown">
      <Grid MaxWidth="360" Margin="12" VerticalAlignment="Center">
        <!-- 投影单独垫一层：Effect 加在卡片上会让里面的文字失去 ClearType -->
        <Border Background="{DynamicResource DialogBackground}" CornerRadius="10" Effect="{DynamicResource ModalShadow}"/>
        <Border Background="{DynamicResource DialogBackground}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <StackPanel Margin="24,22,24,20">
              <TextBlock x:Name="ModalTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock x:Name="ModalBody" Margin="0,8,0,0" FontSize="12" LineHeight="19" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
            <Border Background="{DynamicResource DialogFooterBackground}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,9,9" Padding="16,14">
              <UniformGrid x:Name="ModalButtons" Rows="1" Margin="-4,0"/>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
