<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Claude 当前亮色奶油暖灰 + Claude 橙（clay #D97757）；按钮、Toast 用白色 -->
  <Color x:Key="ColorBackgroundPrimary">#F9F9F7</Color>
  <Color x:Key="ColorBackgroundSecondary">#F3F3F0</Color>
  <Color x:Key="ColorBackgroundTertiary">#FFFFFF</Color>
  <Color x:Key="ColorBackgroundHover">#E7E6E1</Color>
  <Color x:Key="ColorBorder">#D2D1C7</Color>
  <Color x:Key="ColorBorderStrong">#A5A49A</Color>
  <Color x:Key="ColorAccentPrimary">#D97757</Color>
  <Color x:Key="ColorAccentSuccess">#1A7F37</Color>
  <Color x:Key="ColorAccentDanger">#CF222E</Color>
  <Color x:Key="ColorAccentWarning">#BF8700</Color>
  <Color x:Key="ColorCloseButtonPressed">#B62324</Color>
  <!-- 模式强调色：浏览=橙，浮窗=蓝（主窗描边闪；原浮窗琥珀色与橙太近，改蓝） -->
  <Color x:Key="ColorModeBrowsingAccent">#D97757</Color>
  <Color x:Key="ColorModeFloatingAccent">#0969DA</Color>
  <!-- 分段控件：轨道比面板底深一级、选中项为白色凸起 -->
  <Color x:Key="ColorSegmentTrack">#EAE9E4</Color>
  <Color x:Key="ColorSegmentThumb">#FFFFFF</Color>
  <Color x:Key="ColorSegmentTrackBorder">#DEDDD6</Color>
  <Color x:Key="ColorListDivider">#E7E6E1</Color>
  <Color x:Key="ColorTextPrimary">#141413</Color>
  <Color x:Key="ColorTextSecondary">#6D6B67</Color>
  <Color x:Key="ColorTextTertiary">#97958D</Color>
  <!-- 文本选区：TextBox 以 SelectionOpacity 0.4 叠加，直接用强调色 -->
  <Color x:Key="ColorSelection">#D97757</Color>

  <SolidColorBrush x:Key="BackgroundPrimary" Color="{StaticResource ColorBackgroundPrimary}"/>
  <SolidColorBrush x:Key="BackgroundSecondary" Color="{StaticResource ColorBackgroundSecondary}"/>
  <SolidColorBrush x:Key="BackgroundTertiary" Color="{StaticResource ColorBackgroundTertiary}"/>
  <SolidColorBrush x:Key="BackgroundHover" Color="{StaticResource ColorBackgroundHover}"/>
  <SolidColorBrush x:Key="BorderColor" Color="{StaticResource ColorBorder}"/>
  <SolidColorBrush x:Key="BorderColorStrong" Color="{StaticResource ColorBorderStrong}"/>
  <SolidColorBrush x:Key="AccentPrimary" Color="{StaticResource ColorAccentPrimary}"/>
  <SolidColorBrush x:Key="AccentSuccess" Color="{StaticResource ColorAccentSuccess}"/>
  <SolidColorBrush x:Key="AccentDanger" Color="{StaticResource ColorAccentDanger}"/>
  <SolidColorBrush x:Key="AccentWarning" Color="{StaticResource ColorAccentWarning}"/>
  <SolidColorBrush x:Key="CloseButtonPressed" Color="{StaticResource ColorCloseButtonPressed}"/>
  <SolidColorBrush x:Key="ModeBrowsingAccent" Color="{StaticResource ColorModeBrowsingAccent}"/>
  <SolidColorBrush x:Key="ModeFloatingAccent" Color="{StaticResource ColorModeFloatingAccent}"/>
  <SolidColorBrush x:Key="SegmentTrackBackground" Color="{StaticResource ColorSegmentTrack}"/>
  <SolidColorBrush x:Key="SegmentThumbBackground" Color="{StaticResource ColorSegmentThumb}"/>
  <SolidColorBrush x:Key="SegmentTrackBorderBrush" Color="{StaticResource ColorSegmentTrackBorder}"/>
  <SolidColorBrush x:Key="ListDivider" Color="{StaticResource ColorListDivider}"/>
  <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource ColorTextPrimary}"/>
  <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource ColorTextSecondary}"/>
  <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource ColorTextTertiary}"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource ColorSelection}"/>

  <!-- 凸起面（分段控件选中块）：白底 + 极淡发丝描边 + 柔和下投影（iOS / macOS 分段控件同款做法） -->
  <SolidColorBrush x:Key="RaisedBorderBrush" Color="#12000000"/>
  <DropShadowEffect x:Key="RaisedShadow" Color="#000000" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
</ResourceDictionary>
